theme
{
	name="modern"
	dark=0
	background
	{
		color=auto
		opacity=50
		effect=2
	}
	image.align=2
 item  
    {  
        text  
        {  
            normal = #000000          // 普通状态 - 黑色  
            normal.disabled = #808080 // 禁用状态 - 灰色  
            select = #000000          // 选中状态 - 黑色  
            select.disabled = #808080 // 禁用选中状态 - 灰色  
        }  
    }  
}